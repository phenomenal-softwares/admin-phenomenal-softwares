rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'info@phenomenalproductions.com.ng';
    }

    match /phenomenal-softwares/products/{productId}/{filePath=**} {
      allow read, write: if isAdmin();
    }
  }
}
